<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-add-allowed-redirect-uris-to-service" author="fiware">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="service" columnName="allowed_redirect_uris"/>
            </not>
        </preConditions>
        <comment>Add allowed_redirect_uris column to service table</comment>
        <addColumn tableName="service">
            <column name="allowed_redirect_uris" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="100-tag-db" author="fiware">
        <tagDatabase tag="v2.0.4"/>
    </changeSet>
</databaseChangeLog>
